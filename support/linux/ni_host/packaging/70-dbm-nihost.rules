# Access to the Native Instruments Maschine Mk2 (17cc:1140) and JAM (17cc:1500) over hidraw, needed
# by dbm-nihost and by libdbm_nihost (zynthian's Maschine drivers): for the group audio, and for
# the user of the active seat session (uaccess). The group because uaccess grants nothing while no
# session is active on the seat (zynthian's kiosk on the Duet: its ACL went away at the next udev
# event of the nodes, 2026-11-08). Install to /etc/udev/rules.d/ (or /usr/lib/udev/rules.d/), then
#   sudo udevadm control --reload && sudo udevadm trigger
KERNEL=="hidraw*", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="1140", MODE="0660", GROUP="audio", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="1500", MODE="0660", GROUP="audio", TAG+="uaccess"

# Access to the display of the Ableton Push 2 (2982:1967) and Push 3 (2982:1969, the ID of
# DrivenByMoss' Push3ControllerDefinition): USB interface 0, bulk endpoint 0x01, written through
# usbdevfs (/dev/bus/usb/BBB/DDD) by the Python hosts (bindings/python/drivenbymoss/usb.py: the
# reference host, zynthian's Push drivers). The pads and buttons are class compliant USB MIDI and
# need no rule. Bitwig claims the device through its own USB access (also /dev/bus/usb), which
# needs the same rule.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2982", ATTR{idProduct}=="1967", MODE="0660", GROUP="audio", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2982", ATTR{idProduct}=="1969", MODE="0660", GROUP="audio", TAG+="uaccess"
