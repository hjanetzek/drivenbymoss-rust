# Access to the Native Instruments Maschine Mk2 (17cc:1140) and JAM (17cc:1500) over hidraw, needed
# by dbm-nihost and by libdbm_nihost (zynthian's Maschine drivers): for the group audio, and for
# the user of the active seat session (uaccess). The group because uaccess grants nothing while no
# session is active on the seat (zynthian's kiosk on the Duet: its ACL went away at the next udev
# event of the nodes, 2026-11-08). Install to /etc/udev/rules.d/ (or /usr/lib/udev/rules.d/), then
#   sudo udevadm control --reload && sudo udevadm trigger
KERNEL=="hidraw*", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="1140", MODE="0660", GROUP="audio", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="17cc", ATTRS{idProduct}=="1500", MODE="0660", GROUP="audio", TAG+="uaccess"
