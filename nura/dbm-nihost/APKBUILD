# dbm-nihost for postmarketOS/Nura: the NI host emulation of the Maschine Mk2 and JAM
# (support/linux/ni_host):
# - libdbm_nihost.so (/usr/lib/dbm-nihost/), which the DrivenByMoss zynthian drivers of these
#   controllers load to drive them in zynthian's process (doc/ZYNTHIAN_INTEGRATION.md §10),
# - the udev rule for the hidraw access, which both need,
# - the daemon dbm-nihost with its user service (ALSA sequencer ports, for Bitwig and the like),
#   no longer enabled: on zynthian it would take the devices from the drivers.
#
# Built from a checkout of this repository:
#   pmbootstrap build --src=/path/to/drivenbymoss-rust dbm-nihost
pkgname=dbm-nihost
pkgver=0.2.0
pkgrel=0
pkgdesc="NI Maschine Mk2 and JAM host for Linux (hidraw to template MIDI: library and daemon)"
url="https://github.com/hjanetzek/drivenbymoss-rust"
arch="aarch64 x86_64"
license="LGPL-3.0-only"
depends=""
makedepends="alsa-lib-dev cmake samurai"
builddir="$srcdir/$pkgname"

build() {
	cmake -S support/linux/ni_host -B build-nihost -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build-nihost
}

check() {
	ctest --test-dir build-nihost --output-on-failure
}

package() {
	DESTDIR="$pkgdir" cmake --install build-nihost
	local share="$pkgdir"/usr/share/dbm-nihost

	# hidraw access for the logged-in user (zynthian's drivers with the library, or the daemon)
	install -Dm644 "$share"/70-dbm-nihost.rules -t "$pkgdir"/usr/lib/udev/rules.d/

	# The library's header: nothing here builds against it (the drivers use ctypes)
	rm -rf "$pkgdir"/usr/include

	# The user service, not enabled: zynthian's Maschine drivers drive the devices themselves
	# with libdbm_nihost, and only one process can (the daemon would take them first at login).
	# Elsewhere (Bitwig): systemctl --user enable --now dbm-nihost. --virmidi only matters with
	# snd-virmidi loaded; its files stay in /usr/share/dbm-nihost, not installed into
	# modules-load.d
	mkdir -p "$pkgdir"/usr/lib/systemd/user
	mv "$pkgdir"/usr/share/systemd/user/dbm-nihost.service "$pkgdir"/usr/lib/systemd/user/
	rmdir -p "$pkgdir"/usr/share/systemd/user 2>/dev/null || true
}
